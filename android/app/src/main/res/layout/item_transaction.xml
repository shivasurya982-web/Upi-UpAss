<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTransactionItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: App Name & Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="PhonePe"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:34 PM"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Package Name Subtext -->
        <TextView
            android:id="@+id/itemAppPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="com.phonepe.app"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Middle row: Amount & Status Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹499.37"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemDirectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@color/success_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="INCOMING"
                android:textColor="@color/success_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemForwardedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/success_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Forwarded: YES"
                android:textColor="@color/success_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sender & UTR Info -->
        <TextView
            android:id="@+id/itemSenderAndUtr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sender: Sivakumar | UTR: 123456789012"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Notification Text Snippet -->
        <TextView
            android:id="@+id/itemRawSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Received ₹499.37 from Sivakumar via UPI..."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Server Status Row -->
        <TextView
            android:id="@+id/itemServerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Server: HTTP 200 (Success)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="italic" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
